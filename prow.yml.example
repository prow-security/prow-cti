# Prow CTI — configuration file
# Copy to prow.yml and edit. Environment variables override top-level
# settings (see docs/design/connector-config.md for the full list).
#
# ${VAR} substitution is NOT supported in v0.2 — values are literal strings.

connectors:
  # CISA Known Exploited Vulnerabilities
  # Free, no auth. Runs every 6 hours by default.
  - name: cisa-kev
    id: cisa-kev           # stable instance ID — do not change after first ingest
    enabled: true
    schedule: "6h"
    config:
      feed_url: "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
      http_timeout_seconds: 30

  # MITRE ATT&CK Enterprise
  # Full STIX 2.1 dataset: techniques, groups, software, mitigations, x-mitre-* types.
  - name: mitre-attack
    id: mitre-attack
    enabled: true
    schedule: "24h"
    allow_custom_types: true
    config:
      stix_url: "https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json"
      include_deprecated: false

  # abuse.ch URLhaus
  # Requires a free API key from https://urlhaus.abuse.ch/api/
  # Sign up at https://auth.abuse.ch/ and set auth_key below.
  - name: urlhaus
    id: urlhaus
    enabled: false          # set to true after adding your API key
    schedule: "1h"
    config:
      limit: 1000
      auth_key: ""          # required — get yours at urlhaus.abuse.ch/api/

  # abuse.ch ThreatFox
  # Requires a free API key from https://threatfox.abuse.ch/api/
  - name: threatfox
    id: threatfox
    enabled: false          # set to true after adding your API key
    schedule: "1h"
    config:
      days_back: 7
      auth_key: ""          # required — get yours at threatfox.abuse.ch

  # abuse.ch MalwareBazaar
  # Requires a free API key from https://bazaar.abuse.ch/api/
  - name: malwarebazaar
    id: malwarebazaar
    enabled: false          # set to true after adding your API key
    schedule: "6h"
    config:
      limit: 100
      auth_key: ""          # required — get yours at bazaar.abuse.ch

database:
  # Override with PROW_DATABASE_URL environment variable.
  url: "postgresql+asyncpg://prow:prow@localhost:5432/prow"
  pool_size: 10

api:
  host: "0.0.0.0"
  port: 8000
  cors_origins: ["*"]

log:
  level: "info"            # debug | info | warning | error
