{
  "name": "mitre-attack",
  "type": "external_import",
  "version": "0.1.0",
  "display_name": "MITRE ATT&CK Enterprise",
  "description": "Ingests the MITRE ATT&CK Enterprise STIX 2.1 dataset (techniques, groups, software, mitigations, and relationships).",
  "config_schema": {
    "type": "object",
    "properties": {
      "stix_url": {
        "type": "string",
        "default": "https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json"
      },
      "include_deprecated": {
        "type": "boolean",
        "default": false
      },
      "http_timeout_seconds": {
        "type": "number",
        "default": 120
      }
    }
  }
}
