{
  "name": "urlhaus",
  "type": "external_import",
  "version": "0.1.0",
  "display_name": "abuse.ch URLhaus",
  "description": "Ingests recent malicious URLs from abuse.ch URLhaus as STIX 2.1 url observables, indicators, and relationships.",
  "config_schema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "default": 1000
      },
      "min_confidence": {
        "type": "integer",
        "default": 0
      },
      "api_base": {
        "type": "string",
        "default": "https://urlhaus-api.abuse.ch/v1"
      },
      "auth_key": {
        "type": "string",
        "description": "Optional abuse.ch Auth-Key when required by the API."
      },
      "http_timeout_seconds": {
        "type": "number",
        "default": 60
      },
      "user_agent": {
        "type": "string",
        "default": "Prow-CTI/0.1 (security research; https://github.com/prow-cti)"
      }
    }
  }
}
