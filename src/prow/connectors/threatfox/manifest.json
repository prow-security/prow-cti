{
  "name": "threatfox",
  "type": "external_import",
  "version": "0.1.0",
  "display_name": "abuse.ch ThreatFox",
  "description": "Ingests IOCs from abuse.ch ThreatFox as STIX 2.1 observables, indicators, relationships, and optional malware family objects.",
  "config_schema": {
    "type": "object",
    "properties": {
      "days_back": {
        "type": "integer",
        "default": 7
      },
      "api_url": {
        "type": "string",
        "default": "https://threatfox-api.abuse.ch/api/v1/"
      },
      "auth_key": {
        "type": "string",
        "description": "Optional abuse.ch Auth-Key when required by the API."
      },
      "http_timeout_seconds": {
        "type": "number",
        "default": 60
      },
      "user_agent": {
        "type": "string",
        "default": "Prow-CTI/0.1 (security research; https://github.com/prow-cti)"
      }
    }
  }
}
