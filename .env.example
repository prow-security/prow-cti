# Copy to `.env` for local settings (never commit `.env`).

# Async Postgres DSN (SQLAlchemy + asyncpg). Used by Alembic and the persister.
# PROW_DATABASE_URL=postgresql+asyncpg://prow:prow@127.0.0.1:5432/prow

# Optional: integration tests that apply migrations (`tests/db/test_migrations_apply.py`).
# PROW_TEST_DATABASE_URL=postgresql+asyncpg://prow:prow@127.0.0.1:5432/prow
